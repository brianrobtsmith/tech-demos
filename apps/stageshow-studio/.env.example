# Mock mode runs with no keys. Set MOCK_PROVIDERS=1 to force fixtures
# even when a key is present.
MOCK_PROVIDERS=

# US-hosted providers only. The first key in this order is used,
# unless MODEL_PROVIDER picks one (openai | anthropic | together | fireworks | baseten).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
BASETEN_API_KEY=

# Optional model overrides. DeepSeek, Kimi, Qwen, GLM, and other
# Chinese-lab models are ignored.
OPENAI_MODEL=
ANTHROPIC_MODEL=
TOGETHER_MODEL=
FIREWORKS_MODEL=
BASETEN_MODEL=
MODEL_PROVIDER=

# Optional path to an installed Stageshow SKILL.md. When unset, the
# server looks in ~/.agents/skills/stageshow/SKILL.md and falls back
# to a short summary. The skill kit is never copied into this app.
STAGESHOW_SKILL_PATH=
