# Copy to .env.local and fill in whichever provider you have.
# Keys are read only inside Next.js route handlers and never reach the browser.
# With no key, or with MOCK_PROVIDERS=1, the interview is a scripted mock.
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
BASETEN_API_KEY=

# Set to 1 to force the scripted interview even when a key is present.
# MOCK_PROVIDERS=1
