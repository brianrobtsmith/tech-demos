# Copy to .env.local and fill in whichever providers you have.
# Providers without a key show as disabled in the UI (or stream a labeled
# mock response if MOCK_PROVIDERS=1). Keys never leave the server.
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
BASETEN_API_KEY=

# Optional: set to 1 to let keyless providers stream a canned response with
# simulated latency, so the race UI can be demoed without any real keys.
# MOCK_PROVIDERS=1
